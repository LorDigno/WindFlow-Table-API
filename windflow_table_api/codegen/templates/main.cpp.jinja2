#include <iostream>
#include <string>
#include <vector>
#include <optional>
#include <fstream>
#include <sstream>
#include <chrono>
#include <windflow.hpp>
#include <windflow_table_api.hpp>
#include "{{ query_id }}_structs.hpp"

int main(int argc, char* argv[]) {
{% if epoch_var %}
    //variabile di epoch per la normalizzazione dei timestamp
    uint64_t {{epoch_var}} = parse_{{epoch_format}}("{{epoch_str}}");
{% endif %}

    //-----     OPERATOR BUILDERS   -----

    {% for b in builders %}
    {{ b }}

    {% endfor %}
    //-----     PIPES AND TOPOLOGY  ------
    wf::PipeGraph topology(
        "{{ query_id }}", 
        wf::Execution_Mode_t::DEFAULT
        {% if policy %}
        , wf::Time_Policy_t::{{ policy }} 
        {% endif %}
    );

    {% for name in pipe_order %}
    {{ pipes[name] }};

    {% endfor %}
    topology.run();
    return 0;
}