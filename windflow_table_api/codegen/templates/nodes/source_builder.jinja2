auto {{ var_name }} = Table_Source_Builder<{{ out_struct }}>( "{{ filepath }}",
    {{ parser_func }}
)
    .withName("{{ op_name }}")
{% if has_header %}
    .withHeader()
{% endif %}
{% if par > 1%}
    .withParallelism({{ par }}, {{ split_size }}ULL)
{% endif %}
{% if event_time %}
    {% if is_ordered %}
    .withOrderedEventTime({{epoch_var}})
    {% else %}
    .withDelayedEventTime({{ epoch_var }}, {{ delay }}ULL)
    {% endif %}
{% endif %}
    .build();