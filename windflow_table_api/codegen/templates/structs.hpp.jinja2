#ifndef {{ query_id | upper }}_STRUCTS_HPP
#define {{ query_id | upper }}_STRUCTS_HPP

#include <string>
#include <cstdint>
#include <functional>
#include <limits>

{% for s in structs %}
// ============================================================================
// Struct: {{ s.struct_name }}
// ============================================================================
struct {{ s.struct_name }} {
{% for f in s.fields %}
    {% if f.default %}
    {{ f.cpp_type }} {{ f.name }} = {{ f.default }}; 
    {% else %}
    {{ f.cpp_type }} {{ f.name }};
{% endif %}
{% endfor %}

{% if s.needs_win %}
    {{ s.struct_name }}() = default;

    {{ s.struct_name }}(uint64_t _id) 
        : win_id(_id) {}

{% if s.key_struct %}
    {{ s.struct_name }}(const {{ s.key_struct.struct_name }}& _key, uint64_t _id) 
        :{% for k in s.key_struct.fields %} {{ k.name }}(_key.{{ k.name }}),{% endfor %} win_id(_id) {}
{% endif %}
{% endif %}

{% if s.needs_hash %}
    bool operator==(const {{ s.struct_name }}& other) const {
        return {% for f in s.fields %}{{ f.name }} == other.{{ f.name }}{% if not loop.last %} && {% endif %}{% endfor %};
    }
{% endif %}
};

{% if s.needs_hash %}
namespace std {
    template<>
    struct hash<{{ s.struct_name }}> {
        size_t operator()(const {{ s.struct_name }}& k) const {
            size_t h = 0;
            {% for f in s.fields %}
            h ^= std::hash<{{ f.cpp_type }}>{}(k.{{ f.name }}) + 0x9e3779b9 + (h << 6) + (h >> 2);
            {% endfor %}
            return h;
        }
    };
}
{% endif %}

{% endfor %}
#endif // {{ query_id | upper }}_STRUCTS_HPP